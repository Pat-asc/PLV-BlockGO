        "w": 8,
        "x": 8,
        "y": 24
      },
      "id": 9,
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"plv-fabric\",pod=~\"(frontend|dotnet-.*|middleware-api|auth-service|fabric-identity-service|ledger-service|grade-upload-service|settings-service)-.*\",container=~\"frontend-nginx|dotnet-.*|api-gateway|auth-service|identity-service|ledger-service|upload-service|settings-service\"}",
          "legendFormat": "{{pod}} {{container}}",
          "refId": "A"
        }
      ],
      "title": "Platform Pod Restarts",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "id": 10,
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"plv-fabric\",pod=~\"(frontend|dotnet-.*|middleware-api|auth-service|fabric-identity-service|ledger-service|grade-upload-service|settings-service)-.*\",container=~\"frontend-nginx|dotnet-.*|api-gateway|auth-service|identity-service|ledger-service|upload-service|settings-service\"} / container_spec_memory_limit_bytes{namespace=\"plv-fabric\",pod=~\"(frontend|dotnet-.*|middleware-api|auth-service|fabric-identity-service|ledger-service|grade-upload-service|settings-service)-.*\",container=~\"frontend-nginx|dotnet-.*|api-gateway|auth-service|identity-service|ledger-service|upload-service|settings-service\"}",
          "legendFormat": "{{pod}} {{container}}",
          "refId": "A"
        }
      ],
