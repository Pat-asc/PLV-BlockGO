{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"plv-fabric\",pod=~\"middleware-api-.*\",container=\"api-gateway\"})",
          "legendFormat": "{{pod}} working set",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (container_memory_rss{namespace=\"plv-fabric\",pod=~\"middleware-api-.*\",container=\"api-gateway\"})",
          "legendFormat": "{{pod}} rss",
          "refId": "B"
        }
      ],
      "title": "Middleware Memory",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (pod) (deriv(container_memory_working_set_bytes{namespace=\"plv-fabric\",pod=~\"middleware-api-.*\",container=\"api-gateway\"}[15m]))",
          "legendFormat": "{{pod}} working-set trend",
          "refId": "A"
        }
      ],
      "title": "Memory Growth Trend (15m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "blockgo_gateway_cache_entries{job=\"middleware-services\",service=\"ledger-service\"}",
          "legendFormat": "{{pod}} gateways",
          "refId": "A"
        },
        {
          "expr": "blockgo_ca_config_cache_entries{job=\"middleware-services\",service=\"fabric-identity-service\"}",
          "legendFormat": "{{pod}} CA configs",
          "refId": "B"
        }
      ],
      "title": "Cache Entries",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_requests_total{job=\"middleware-api\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, pod) (rate(http_request_duration_seconds_bucket{job=\"middleware-api\"}[5m])))",
          "legendFormat": "{{pod}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(http_request_duration_seconds_bucket{job=\"middleware-api\"}[5m])))",
          "legendFormat": "{{pod}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, pod) (rate(http_request_duration_seconds_bucket{job=\"middleware-api\"}[5m])))",
          "legendFormat": "{{pod}} p99",
          "refId": "C"
        }
      ],
      "title": "Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"plv-fabric\",pod=~\"middleware-api.*\",container=\"api-gateway\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pod Restarts",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"plv-fabric\",pod=~\"middleware-api.*\",container=\"api-gateway\"} / container_spec_memory_limit_bytes{namespace=\"plv-fabric\",pod=~\"middleware-api.*\",container=\"api-gateway\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Middleware Memory Limit Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 8,
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"plv-fabric\",deployment=~\"frontend|dotnet-.*|middleware-api|auth-service|fabric-identity-service|ledger-service|grade-upload-service|settings-service\"}",
          "legendFormat": "{{deployment}} available",
          "refId": "A"
        }
      ],
      "title": "Platform Available Replicas",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
