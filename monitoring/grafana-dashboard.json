      "targets": [
        {
          "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"plv-fabric\",pod=~\"(frontend|dotnet-.*|middleware-api|auth-service|fabric-identity-service|ledger-service|grade-upload-service|settings-service)-.*\",container=~\"frontend-nginx|dotnet-.*|api-gateway|auth-service|identity-service|ledger-service|upload-service|settings-service\"}[5m]))",
