apiVersion: batch/v1
kind: Job
metadata:
  name: ipfs-webui-bootstrap
  namespace: plv-fabric
  labels:
    app: ipfs-webui-bootstrap
spec:
  # Gateway fallback is handled inside this one bounded pod.
  backoffLimit: 0
  activeDeadlineSeconds: 300
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app: ipfs-webui-bootstrap
    spec:
      restartPolicy: Never
      containers:
      - name: importer
        image: curlimages/curl:8.14.1
        imagePullPolicy: IfNotPresent
        resources:
          requests:
            cpu: 5m
            memory: 8Mi
          limits:
            memory: 64Mi
        env:
        - name: WEBUI_CID
          value: "bafybeihxglpcfyarpm7apn7xpezbuoqgk3l5chyk7w4gvrjwk45rqohlmm"
        - name: IPFS_APIS
          value: "http://ipfs-api.plv-fabric.svc.cluster.local:5001 http://ipfs-annex-api.plv-annex-campus.svc.cluster.local:5001 http://ipfs-pubad-api.plv-pubad-campus.svc.cluster.local:5001"
        - name: WEBUI_GATEWAYS
          value: "https://dweb.link/ipfs https://ipfs.io/ipfs https://ipfs.filebase.io/ipfs"
        command:
        - /bin/sh
        - -ec
        - |
          for IPFS_API in ${IPFS_APIS}; do
            API_READY=false
            for ATTEMPT in $(seq 1 20); do
              if curl -fsS --connect-timeout 2 --max-time 5 \
                -X POST "${IPFS_API}/api/v0/id" >/dev/null; then
                API_READY=true
                break
              fi
              echo "Waiting for ${IPFS_API}..."
              sleep 3
            done

            if [ "${API_READY}" != "true" ]; then
              echo "ERROR: ${IPFS_API} did not become ready within 60 seconds."
              exit 1
            fi
          done

          NEED_IMPORT=false
          for IPFS_API in ${IPFS_APIS}; do
            if ! curl -fsS -X POST "${IPFS_API}/api/v0/pin/ls?arg=${WEBUI_CID}&type=recursive" >/dev/null 2>&1; then
              NEED_IMPORT=true
            fi
          done

          if [ "${NEED_IMPORT}" = "false" ]; then
            echo "IPFS Web UI ${WEBUI_CID} is already pinned on all three campus nodes."
            exit 0
          fi

          CAR_FILE=/tmp/ipfs-webui.car
          DOWNLOADED=false
          for GATEWAY in ${WEBUI_GATEWAYS}; do
            PART_FILE="${CAR_FILE}.part"
            rm -f "${PART_FILE}"
            URL="${GATEWAY%/}/${WEBUI_CID}?format=car"
            echo "Downloading the Kubo 0.41 Web UI CAR from ${GATEWAY}..."

            if curl -fsSL \
              --connect-timeout 5 \
              --max-time 60 \
              --speed-limit 1024 \
              --speed-time 15 \
              -H "Accept: application/vnd.ipld.car" \
              "${URL}" \
              -o "${PART_FILE}"; then
              if [ ! -s "${PART_FILE}" ]; then
                echo "WARNING: ${GATEWAY} returned an empty CAR; trying the next gateway."
                continue
              fi

              mv "${PART_FILE}" "${CAR_FILE}"
              DOWNLOADED=true
              break
            fi

            echo "WARNING: ${GATEWAY} could not provide a complete CAR."
          done

          rm -f "${CAR_FILE}.part"
          if [ "${DOWNLOADED}" != "true" ]; then
            echo "WARNING: No configured public gateway provided a complete Web UI CAR."
            echo "The optional local Web UI asset was skipped; the IPFS APIs remain available."
            exit 0
          fi

          for IPFS_API in ${IPFS_APIS}; do
            if curl -fsS -X POST "${IPFS_API}/api/v0/pin/ls?arg=${WEBUI_CID}&type=recursive" >/dev/null 2>&1; then
              echo "${IPFS_API} already has the Web UI pin."
              continue
            fi
            echo "Importing and pinning the Web UI on ${IPFS_API}..."
            curl -fsS -X POST \
              --connect-timeout 5 --max-time 180 \
              -F "file=@${CAR_FILE};type=application/vnd.ipld.car" \
              "${IPFS_API}/api/v0/dag/import?pin-roots=true&stats=true"
            curl -fsS -X POST "${IPFS_API}/api/v0/pin/add?arg=${WEBUI_CID}&recursive=true" >/dev/null
            curl -fsS -X POST "${IPFS_API}/api/v0/pin/ls?arg=${WEBUI_CID}&type=recursive" >/dev/null
          done
          echo "IPFS Web UI is installed and pinned on Main, Annex, and Pubad."
